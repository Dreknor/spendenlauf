APP_NAME=Spendenlauf
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://spendenlauf.example.org
APP_LOCALE=de
APP_TIMEZONE=Europe/Berlin

# Darstellung & Links (Datum, Prozentsätze, Bankdaten usw. werden in der Veranstaltungsverwaltung gepflegt)
SPENDENLAUF_SCHULE="Evangelisches Schulzentrum Radebeul"
LOGO=img/logo.png
LOGO_LINK=https://esz-radebeul.de
DATENSCHUTZ=https://www.spendenlauf-radebeul.de/index.php/datenschutz/
IMPRESSUM=https://esz-radebeul.de/impressum/
# optionale Kopie bei Team-Benachrichtigungen
SPENDENLAUF_ADMIN_MAIL=

# Öffentliche Statistik (/stats) einbetten: z. B. "frame-ancestors 'self' https://www.radebeuler-spendenlauf.de"
Content_Security_Policy="frame-ancestors 'self'"
X_Frame_Options=
STATS_RELOAD=60

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=spendenlauf
DB_USERNAME=spendenlauf
DB_PASSWORD=

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
# "sync" versendet Mails sofort; mit "database" ist ein Queue-Worker nötig (php artisan queue:work)
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@esz-radebeul.de
MAIL_FROM_NAME="${SPENDENLAUF_SCHULE}"

HONEYPOT_ENABLED=true

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

VITE_APP_NAME="${APP_NAME}"
